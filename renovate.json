{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automerge chore dep updates (digest, pin, patch, minor) when CI passes",
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "KDE runner image and Python requirements",
      "matchFileNames": [
        "container/Containerfile.kde-runner",
        "container/requirements.kde-runner.txt"
      ],
      "addLabels": ["kde", "runner"]
    }
  ]
}
