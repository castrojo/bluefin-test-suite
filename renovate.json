{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automerge chore dep updates (digest, pin, patch, minor) when CI passes",
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Hold astro at v5: @astrojs/tailwind 6.x peer range is ^3 || ^4 || ^5, so a major bump breaks `npm ci` in publish-to-pages.yml",
      "matchFileNames": ["dashboard/package.json"],
      "matchPackageNames": ["astro"],
      "allowedVersions": "<6.0.0"
    },
    {
      "description": "KDE runner image and Python requirements",
      "matchFileNames": [
        "container/Containerfile.kde-runner",
        "container/requirements.kde-runner.txt"
      ],
      "addLabels": ["kde", "runner"]
    }
  ]
}
