---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GlobalSearch from '../components/GlobalSearch.astro';

// ── Build-time Data Fetching & SSG ──────────────────────────────────────────
let stats: any = {};
try {
  const statsRes = await fetch('https://projectbluefin.github.io/testing-lab/data/factory-stats.json');
  if (statsRes.ok) {
    stats = await statsRes.json();
  }
} catch (err) {
  console.warn("Failed to fetch factory stats:", err);
}

const IMAGES = (stats.images || []).length ? stats.images : [
  { slug: 'bluefin-testing',         label: 'bluefin:testing' },
  { slug: 'bluefin-lts-testing',     label: 'bluefin-lts:testing' },
  { slug: 'bluefin-bazzite-testing', label: 'bazzite:testing' },
  { slug: 'bluefin-aurora-testing',  label: 'aurora:testing' },
  { slug: 'dakota-testing',          label: 'dakota:testing' },
  { slug: 'flatcar-testing',         label: 'flatcar:testing', suites: ['flatcar'] },
];

const SUITES = ['smoke', 'developer', 'software', 'system'];

// Parallel fetch of results for all images and suites
const allData: any[] = [];
await Promise.all(IMAGES.flatMap((img: any) => {
  const imgSuites = img.suites || SUITES;
  return imgSuites.map(async (s: string) => {
    try {
      const res = await fetch(`https://projectbluefin.github.io/testing-lab/results/${img.slug}-${s}.json`);
      if (res.ok) {
        const d = await res.json();
        allData.push({ image: img, suite: s, data: d });
      } else {
        allData.push({ image: img, suite: s, data: null });
      }
    } catch (err) {
      console.warn(`Failed to fetch results for ${img.slug}-${s}:`, err);
      allData.push({ image: img, suite: s, data: null });
    }
  });
}));

// Group by image slug
const byImage: any = {};
for (const d of allData) {
  if (!byImage[d.image.slug]) byImage[d.image.slug] = {};
  byImage[d.image.slug][d.suite] = d.data;
}

// Date formatter helpers
function fmtAgo(iso: string) {
  if (!iso) return 'never';
  const ms = Date.now() - new Date(iso).getTime();
  if (ms < 60000)    return 'just now';
  if (ms < 3600000)  return Math.round(ms/60000)+'m ago';
  if (ms < 86400000) return Math.round(ms/3600000)+'h ago';
  return Math.round(ms/86400000)+'d ago';
}

function fmt(iso: string) {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' });
  } catch {
    return iso;
  }
}

const PR_REPOS: any = {
  common:  'projectbluefin/common',
  blu:     'projectbluefin/bluefin',
  lts:     'projectbluefin/bluefin-lts',
  aurora:  'ublue-os/aurora',
  bazzite: 'ublue-os/bazzite',
  dakota:  'projectbluefin/dakota',
};

function prContext(wfName: string) {
  if (!wfName) return null;
  const m = wfName.match(/^([a-z]+)-(\d+)-/);
  if (!m) return null;
  const [, prefix, num] = m;
  const repo = PR_REPOS[prefix];
  if (!repo) return null;
  return { repo, num, url: `https://github.com/${repo}/pull/${num}` };
}

function prLabel(wfName: string) {
  const ctx = prContext(wfName);
  if (!ctx) return null;
  return {
    repo: ctx.repo.split('/')[1],
    num: ctx.num,
    url: ctx.url
  };
}

function triggerLabel(r: any) {
  const pr = prLabel(r.id || r.workflow_name || '');
  if (pr) return `PR #${pr.num} (${pr.repo})`;
  const t = r.trigger || '';
  if (t === 'nightly')   return 'nightly';
  if (t === 'manual')    return 'manual';
  if (t === 'pr-poller') return 'pr-poller';
  return t || '—';
}

function failingSince(history: any[]) {
  if (!history?.length) return { since: null, consecutiveRuns: 0 };
  let since = null;
  let consecutiveRuns = 0;
  for (const h of history) {
    if (h.status === 'failed') { since = h.run || h.run_date; consecutiveRuns++; }
    else break;
  }
  return { since, consecutiveRuns };
}

function lastGreenRun(allSuiteData: any, imgSuites: string[]) {
  const runMap: any = {};
  for (const s of imgSuites) {
    const d = allSuiteData[s];
    if (!d?.history?.length) continue;
    for (const h of d.history) {
      const key = h.run || h.run_date;
      if (!key) continue;
      if (!runMap[key]) runMap[key] = {};
      runMap[key][s] = h.status;
    }
  }
  const dates = Object.keys(runMap).sort().reverse();
  for (const dt of dates) {
    const statuses = Object.values(runMap[dt]);
    if (statuses.length > 0 && statuses.every(s => s === 'passed')) return dt;
  }
  return null;
}

function nightlyOverdue(img: any, row: any) {
  const utcHour = img.nightly_time_utc;
  if (!utcHour) return null;
  const [h, m] = utcHour.split(':').map(Number);
  const now = new Date();
  const expectedToday = new Date(Date.UTC(
    now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), h, m
  ));
  const expectedRun = now < expectedToday
    ? new Date(expectedToday.getTime() - 86400000)
    : expectedToday;
  const lastRuns = Object.values(row).map((d: any) => d?.last_run).filter(Boolean).sort();
  const lastRun = lastRuns.length ? new Date(lastRuns[lastRuns.length - 1] as any) : null;
  if (lastRun && lastRun >= expectedRun) return null;
  const hoursOverdue = Math.round((now.getTime() - expectedRun.getTime()) / 3600000);
  return hoursOverdue > 0 ? hoursOverdue : null;
}

const ARGO_UI = 'http://192.168.1.102:32746';
const GH_REPO = 'https://github.com/projectbluefin/testing-lab';

const SUITE_DEBUG_HINTS: any = {
