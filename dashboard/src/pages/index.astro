// Computed state variables
const failures = allData.filter(d => d.data?.status === 'failed');
const bugs = stats.open_bugs || [];
const runs = stats.recent_runs || [];
const infraFails = runs.filter(r => r.overall === 'fail' && !r.smoke && !r.developer && !r.system);
const stuck = runs.filter(r => r.overall === 'running' &&
  (Date.now() - new Date(r.started_at).getTime()) / 60000 > 90);

// PR Failure map
const prFailMap: any = {};
for (const r of runs.filter(r => r.overall === 'fail')) {
  const ctx = prContext(r.id || r.workflow_name || '');
  if (ctx) prFailMap[`${ctx.repo}#${ctx.num}`] = true;
}
const blockedPRs = Object.keys(prFailMap).length;

// Overdue nightlies
const overdueImages = IMAGES.filter(img => {
  const row = byImage[img.slug] || {};
  return nightlyOverdue(img, row) !== null;
});

const systemFails = failures.filter(f => f.suite === 'system');

// Build PR Matrix
const prGroupMap: any = {};
for (const r of runs) {
  const ctx = prContext(r.id || r.workflow_name || '');
  if (!ctx) continue;
  const key = `${ctx.repo}#${ctx.num}`;
  if (!prGroupMap[key]) prGroupMap[key] = { ctx, runs: [] };
  prGroupMap[key].runs.push(r);
}
const prList = Object.values(prGroupMap);

// Triage sections
const neverTested = IMAGES.filter(img => !(byImage[img.slug] && Object.values(byImage[img.slug]).some((d: any) => d?.last_run)));
const partialCoverage = IMAGES.filter(img => {
  const suitesRan = Object.keys(byImage[img.slug] || {}).filter(s => byImage[img.slug][s]?.last_run).length;
  const totalSuites = (img.suites || ['smoke', 'developer', 'software', 'system']).length;
  return suitesRan > 0 && suitesRan < totalSuites;
});

// Nightly schedules strip helpers
const nightlyChips = IMAGES
  .filter(img => img.nightly_time_utc)
  .map(img => {
    const [h, m] = img.nightly_time_utc.split(':').map(Number);
    const now = new Date();
    const expectedToday = new Date(Date.UTC(
      now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), h, m));
    const nextRun = now < expectedToday ? expectedToday : new Date(expectedToday.getTime() + 86400000);
    const minsUntil = Math.round((nextRun.getTime() - now.getTime()) / 60000);
    const hoursUntil = Math.round(minsUntil / 60);

    const row = byImage[img.slug] || {};
    const lastRuns = Object.values(row).map((d: any) => d?.last_run).filter(Boolean).sort();
    const lastRun = lastRuns.length ? lastRuns[lastRuns.length - 1] : null;
    const expectedPrev = now < expectedToday ? new Date(expectedToday.getTime() - 86400000) : expectedToday;
    const isOverdue = !lastRun || new Date(lastRun as any) < expectedPrev;

    let countdownColor = '';
    let countdownText = '';
    if (isOverdue) {
      const hOverdue = Math.round((now.getTime() - expectedPrev.getTime()) / 3600000);
      countdownColor = 'text-rose-400';
      countdownText = `⚠ overdue ${hOverdue}h`;
    } else if (minsUntil < 60) {
      countdownColor = 'text-amber-400';
      countdownText = `in ${minsUntil}m`;
    } else {
      countdownColor = 'text-slate-400';
      countdownText = `in ${hoursUntil}h`;
    }

    return {
      label: img.label,
      time: img.nightly_time_utc,
      countdownColor,
      countdownText
    };
  });

// Recent active running workflows
const activeRunning = runs.filter(r => {
  if (r.overall !== 'running') return false;
  const age = Date.now() - new Date(r.started_at).getTime();
  return age < 3 * 3600 * 1000;
});

// Generated Timestamp Metadata
const genTime = stats._meta?.generated;
const genAgeH = genTime ? (Date.now() - new Date(genTime).getTime()) / 3600000 : Infinity;
const isDataStale = genAgeH > 1.5;
---

<Layout title="Project Bluefin QA Dashboard">
  <Header />

  <main class="container mx-auto px-4 py-8 max-w-7xl flex-grow">
    <!-- Header Summary Strip -->
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white mb-1">QA Observability Dashboard</h1>
        <div class="text-xs text-slate-400 flex flex-wrap items-center gap-2">
          {isDataStale ? (
            <span class="text-amber-400 font-semibold" title="Data may be stuck or updating slowly">
              ⚠ data updated {fmtAgo(genTime)}
            </span>
          ) : (
            <span>Data updated: {fmtAgo(genTime)}</span>
          )}
          <span>•</span>
          <a href={ARGO_UI} target="_blank" rel="noopener" class="text-blue-400 hover:underline">Argo UI</a>
          <span>•</span>
          <a href={GH_REPO} target="_blank" rel="noopener" class="text-blue-400 hover:underline">testing-lab</a>
        </div>
      </div>
      
      <!-- Global Search Bar Integration -->
      <div class="w-full md:w-auto md:min-w-[400px]">
        <GlobalSearch />
      </div>
    </div>

    <!-- Quick Links Bar -->
    <div class="flex flex-wrap gap-2.5 items-center mb-8 text-xs">
      <span class="text-slate-400 font-semibold">Quick links:</span>
      <a href={`${ARGO_UI}/workflows/argo?phase=Failed`} target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">⚠ Failed workflows</a>
      <a href={`${ARGO_UI}/workflows/argo?phase=Running`} target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">▶ Running workflows</a>
      <a href="https://github.com/projectbluefin/testing-lab/issues?q=is%3Aopen+label%3Abug" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">Bugs</a>
      <a href="https://github.com/projectbluefin/testing-lab/issues/new/choose" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">+ File issue</a>
      <a href="https://github.com/projectbluefin/testing-lab/blob/main/RUNBOOK.md" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">RUNBOOK</a>
      <a href="https://github.com/projectbluefin/testing-lab/blob/main/docs/agent-cheatsheet.md" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">Cheatsheet</a>
      <a href="https://github.com/projectbluefin/testing-lab/actions/workflows/update-test-results.yml" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">↻ Refresh data</a>
    </div>

    <!-- Alert Banner -->
    <div class="mb-8">
      {failures.length > 0 || infraFails.length > 0 || blockedPRs > 0 || stuck.length > 0 || bugs.length > 0 || overdueImages.length > 0 ? (
        <div class="bg-rose-500/10 border border-rose-500/20 rounded-xl p-5 flex gap-4 items-start shadow-glow-cyan/5">
          <div class="w-8 h-8 rounded-full bg-rose-500/20 border border-rose-500/30 flex items-center justify-center shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
          </div>
          <div>
            <h2 class="text-sm font-bold text-rose-400 mb-1">Needs Attention:</h2>
            <div class="text-sm text-slate-300 flex flex-wrap gap-x-3 gap-y-1.5 items-center">
              {systemFails.length > 0 && (
                <a href="#failures-section" class="font-bold text-rose-400 hover:underline">
                  ⚑ {systemFails.length} CRITICAL failures
                </a>
              )}
              {failures.length > 0 && (
                <a href="#failures-section" class="hover:underline">
                  <strong>{failures.length}</strong> suite{failures.length > 1 ? 's' : ''} failing
                </a>
              )}
              {infraFails.length > 0 && (
                <a href="#triage-section" class="hover:underline">
                  <strong>{infraFails.length}</strong> pipeline failure{infraFails.length > 1 ? 's' : ''}
                </a>
              )}
              {blockedPRs > 0 && (
                <a href="#pr-matrix-section" class="hover:underline">
                  <strong>{blockedPRs}</strong> PR{blockedPRs > 1 ? 's' : ''} blocked
                </a>
              )}
              {stuck.length > 0 && (
                <a href="#triage-section" class="hover:underline">
                  <strong>{stuck.length}</strong> stuck workflow{stuck.length > 1 ? 's' : ''}
                </a>
              )}
              {bugs.length > 0 && (
                <a href="#triage-section" class="hover:underline">
                  <strong>{bugs.length}</strong> open bug{bugs.length > 1 ? 's' : ''}
                </a>
              )}
              {overdueImages.length > 0 && (
                <a href="#nightly-strip" class="hover:underline">
                  <strong>{overdueImages.length}</strong> nightly overdue
                </a>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-5 flex gap-4 items-center shadow-glow-blue/5">
          <div class="w-8 h-8 rounded-full bg-emerald-500/25 border border-emerald-500/30 flex items-center justify-center shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          </div>
          <div>
            <h2 class="text-sm font-bold text-emerald-400">All Pipelines Healthy</h2>
            <p class="text-xs text-slate-400">No active failures or open bugs are blocking verification.</p>
          </div>
        </div>
      )}
    </div>

    <!-- Nightly Schedule Strip -->
    {nightlyChips.length > 0 && (
      <div class="mb-8" id="nightly-strip">
        <div class="flex flex-wrap gap-2.5 items-center">
          <span class="text-xs font-semibold text-slate-400">Nightly schedule:</span>
          {nightlyChips.map(chip => (
            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-xs">
              <span class="font-bold text-slate-200">{chip.label}</span>
              <span class="text-slate-500">at {chip.time} UTC</span>
              <span class={`font-semibold ${chip.countdownColor}`}>{chip.countdownText}</span>
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Dynamic Quick Stats Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-8">
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl shadow-glow-blue/5 flex flex-col justify-between">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Pipeline Success</span>
        <div class={`text-2xl font-extrabold mt-1 ${stats.pipelines?.containerdisk?.success_rate_pct >= 90 ? 'text-emerald-400' : 'text-amber-400'}`}>
          {stats.pipelines?.containerdisk?.success_rate_pct ?? '—'}%
        </div>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl flex flex-col justify-between">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Runs · 7d</span>
        <div class="text-2xl font-extrabold text-slate-200 mt-1">
          {stats.pipelines?.containerdisk?.runs_7d ?? stats.velocity?.deployments_7d ?? '—'}
        </div>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl flex flex-col justify-between">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Avg Duration</span>
        <div class="text-2xl font-extrabold text-slate-200 mt-1">
          {stats.pipelines?.containerdisk?.avg_total_min ?? '—'}m
        </div>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl flex flex-col justify-between">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Images Tested</span>
        <div class="text-2xl font-extrabold text-slate-200 mt-1">
          {stats.test_coverage?.images_with_results ?? '—'}/{IMAGES.length}
        </div>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl flex flex-col justify-between">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Open issues/PRs</span>
        <div class="text-2xl font-extrabold text-slate-200 mt-1">
          {stats.github?.testing_lab?.open_prs ?? '—'} PRs / {stats.github?.testing_lab?.open_issues ?? '—'} Issues
        </div>
      </div>
    </div>

    <!-- Triage Section -->
    {(bugs.length > 0 || neverTested.length > 0 || partialCoverage.length > 0 || infraFails.length > 0 || stuck.length > 0) && (
      <div class="mb-10" id="triage-section">
        <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Triage Dashboard</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="space-y-6">
            {bugs.length > 0 && (
              <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Open Bugs ({bugs.length})</div>
                <div class="space-y-2">
                  {bugs.map((b: any) => (
                    <div class={`bg-slate-900 border border-slate-800 rounded-xl p-4 flex justify-between items-start gap-3 border-l-4 ${b.area === 'test' ? 'border-l-amber-500' : 'border-l-rose-500'}`}>
                      <div class="flex-grow min-w-0">
                        <a href={b.url} target="_blank" rel="noopener" class="text-sm font-bold text-slate-200 hover:text-blue-400 block truncate">
                          #{b.number}: {b.title}
                        </a>
                        <div class="text-xs text-slate-500 mt-1 flex flex-wrap gap-2">
                          <span>Created {fmtAgo(b.created_at)}</span>
                          {b.affects?.length > 0 && (
                            <span>• Affects: {b.affects.join(', ')}</span>
                          )}
                        </div>
                      </div>
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${b.area === 'test' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20'}`}>
                        {b.area || 'bug'}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            {(neverTested.length > 0 || partialCoverage.length > 0) && (
              <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Coverage Gaps</div>
                <div class="space-y-2">
                  {neverTested.map((img: any) => (
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 border-l-4 border-l-amber-500 flex justify-between items-center gap-3">
                      <div>
                        <div class="text-sm font-bold text-slate-200">{img.label}</div>
                        <div class="text-xs text-slate-500 mt-1 font-mono">{img.image}</div>
                      </div>
                      <div class="flex flex-col items-end gap-1.5 shrink-0">
                        <span class="text-xs text-rose-400 font-semibold">Never tested</span>
                        {WORKFLOW_TEMPLATES[img.slug] && (
                          <a href={`${ARGO_UI}/workflow-templates/argo/${WORKFLOW_TEMPLATES[img.slug]}`} target="_blank" rel="noopener" class="text-[10px] font-bold text-blue-400 hover:underline">
                            ▶ Run in Argo
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                  {partialCoverage.map((img: any) => {
                    const row = byImage[img.slug] || {};
                    const ran = Object.keys(row).filter(s => row[s]?.last_run);
                    const all = img.suites || ['smoke', 'developer', 'software', 'system'];
                    const missing = all.filter((s: string) => !ran.includes(s));
                    return (
                      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 border-l-4 border-l-slate-700">
                        <div class="text-sm font-bold text-slate-200">{img.label}</div>
                        <div class="text-xs text-slate-400 mt-1">Missing suites: {missing.join(', ')}</div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          <div class="space-y-6">
            {infraFails.length > 0 && (
              <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Pipeline Failures — No Test Output ({infraFails.length})</div>
                <div class="space-y-2">
                  {infraFails.slice(0, 8).map((r: any) => {
                    const pr = prLabel(r.id);
                    return (
                      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 border-l-4 border-l-rose-500 flex justify-between items-center gap-3">
                        <div class="min-w-0">
                          <a href={`${ARGO_UI}/workflows/argo/${r.id}`} target="_blank" rel="noopener" class="text-sm font-bold text-slate-200 font-mono hover:text-blue-400 block truncate">
                            {r.id}
                          </a>
                          <div class="text-xs text-slate-500 mt-1">
                            {r.label || r.variant} • {fmtAgo(r.finished_at || r.started_at)}
                          </div>
                        </div>
                        <div class="shrink-0 flex flex-col items-end gap-1.5">
                          {pr && (
                            <a href={pr.url} target="_blank" class="text-xs text-blue-400 hover:underline">
                              {pr.repo}#{pr.num}
                            </a>
                          )}
                          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-500/10 text-rose-400 border border-rose-500/20">
                            No Output
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {stuck.length > 0 && (
              <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Stuck Workflows ({stuck.length})</div>
                <div class="space-y-2">
                  {stuck.map((r: any) => {
                    const dur = Math.round((Date.now() - new Date(r.started_at).getTime()) / 60000);
                    return (
                      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 border-l-4 border-l-amber-500 flex justify-between items-center gap-3">
                        <div>
                          <a href={`${ARGO_UI}/workflows/argo/${r.id}`} target="_blank" rel="noopener" class="text-sm font-bold text-slate-200 font-mono hover:text-blue-400">
                            {r.id}
                          </a>
                          <div class="text-xs text-slate-500 mt-1">{r.label || r.variant}</div>
                        </div>
                        <span class="text-xs text-amber-400 font-semibold">{dur}m running</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- Test Failures Section -->
    {failures.length > 0 && (
      <div class="mb-10" id="failures-section">
        <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Active Test Failures</h2>
        <div class="space-y-4">
          {failures.map(f => {
            const d = f.data;
            const { since, consecutiveRuns } = failingSince(d.history);
            const pr = prLabel(d.workflow_name);
            const isSystem = f.suite === 'system';
            const relatedBugs = bugs.filter((b: any) =>
              b.affects?.some((a: string) => a === f.suite || a === 'all-pipelines' || a === f.image.slug)
            );
            const catalogByFile = SUITE_SCENARIOS[f.suite] || {};
            const allCatalogScenarios = Object.values(catalogByFile).flat();
            const failedSet = new Set(d.failed_scenarios || []);
            const hasFailedNames = !!(d.failed_scenarios?.length);
            const total = d.scenarios || allCatalogScenarios.length;
            const failedCount = d.failed || 0;

            return (
              <div class={`bg-slate-900 border rounded-xl p-5 border-l-4 shadow-glow-cyan/5 ${isSystem ? 'border-rose-900/40 border-l-rose-500' : 'border-slate-800 border-l-rose-500'}`}>
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3">
                    <span class="text-base font-bold text-white">{f.image.label}</span>
                    <span class="px-2 py-0.5 rounded text-xs font-bold uppercase bg-rose-500/10 text-rose-400 border border-rose-500/20">{f.suite}</span>
                    {isSystem && (
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-red-950 text-red-400 border border-red-900">PLATFORM CONTRACT</span>
                    )}
                  </div>
                  <span class="text-sm font-bold text-rose-400">{d.failed} of {d.scenarios} scenarios failing</span>
                </div>

                <div class="flex flex-wrap gap-4 text-xs text-slate-500 mb-4 items-center">
                  {since && (
                    <span>Failing since: <strong class="text-slate-300">{fmtAgo(since)}</strong> {consecutiveRuns > 1 && `(${consecutiveRuns} runs)`}</span>
                  )}
                  {d.workflow_name && (
                    <>
                      <span>•</span>
                      <a href={`${ARGO_UI}/workflows/argo/${d.workflow_name}`} target="_blank" rel="noopener" class="text-blue-400 hover:underline">Argo logs</a>
                      <span>•</span>
                      <span class="font-mono text-slate-400 shrink-0">{d.workflow_name}</span>
                    </>
                  )}
                  <span>•</span>
                  <a href={SUITE_FEATURES[f.suite]} target="_blank" rel="noopener" class="text-slate-400 hover:underline">Feature files</a>
                  {pr ? (
                    <>
                      <span>•</span>
                      <span>Trigger: PR <a href={pr.url} target="_blank" class="text-blue-400 hover:underline">#{pr.num} ({pr.repo})</a></span>
                    </>
                  ) : (
                    <>
                      <span>•</span>
                      <span>Trigger: {triggerLabel(d)}</span>
                    </>
                  )}
                </div>

                {relatedBugs.length > 0 && (
                  <div class="bg-slate-950 border border-slate-800 rounded-lg p-3.5 mb-4 text-xs">
                    <span class="font-semibold text-amber-400 mb-1.5 block">Related open issues:</span>
                    <div class="space-y-1.5">
                      {relatedBugs.map((b: any) => (
                        <a href={b.url} target="_blank" rel="noopener" class="text-amber-400 hover:underline block">
                          #{b.number} — {b.title}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {d.screenshot_url && (
                  <div class="mb-4">
                    <img src={d.screenshot_url} alt="failure screenshot" class="max-w-[240px] max-h-[135px] object-cover rounded border border-slate-800 cursor-pointer block hover:border-slate-500" onclick="window.open(this.src,'_blank')" />
                    <div class="text-[10px] text-slate-500 mt-1">Screenshot at last run • Click to enlarge</div>
                  </div>
                )}

                {allCatalogScenarios.length > 0 ? (
                  <details class="text-xs">
                    <summary class="cursor-pointer text-slate-400 hover:text-white transition-colors select-none font-medium mb-2">
                      ▸ Scenario checklist — {failedCount} failing · {total - failedCount} passing
                    </summary>
                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-4">
                      {Object.entries(catalogByFile).map(([fname, scenarios]: any) => {
                        const fileFailures = scenarios.filter((sc: string) => failedSet.has(sc)).length;
                        return (
                          <div>
                            <div class="font-semibold uppercase tracking-wider text-[10px] text-slate-500 mb-2">
                              {hasFailedNames ? (
                                fileFailures > 0 ? (
                                  <span class="text-rose-400">{fname}.feature ({fileFailures} failing)</span>
                                ) : (
                                  <span class="text-emerald-400">{fname}.feature ✓</span>
                                )
                              ) : (
                                <a href={`${GH_REPO}/blob/main/tests/${f.suite}/features/${fname}.feature`} target="_blank" rel="noopener" class="hover:underline">
                                  {fname}.feature
                                </a>
                              )}
                            </div>
                            <div class="space-y-1">
                              {scenarios.map((sc: string) => {
                                const isFailed = failedSet.has(sc);
                                return (
                                  <div class="flex items-start gap-2 py-0.5">
                                    <span class={`text-[10px] font-bold ${isFailed ? 'text-rose-400' : 'text-emerald-400'}`}>
                                      {isFailed ? '✗' : '✓'}
                                    </span>
                                    <span class={isFailed ? 'text-rose-400' : 'text-slate-300'}>{sc}</span>
                                  </div>
                                );
                              })}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </details>
                ) : (
                  <div class="text-xs text-slate-500 font-medium">
                    Scenario names will appear after next test run. Feature files:
                    <div class="flex gap-2.5 mt-2">
                      {(SUITE_FEATURE_FILES[f.suite] || []).map((name: string) => (
                        <a href={`${GH_REPO}/blob/main/tests/${f.suite}/features/${name}.feature`} target="_blank" class="text-blue-400 hover:underline">{name}.feature</a>
                      ))}
                    </div>
                  </div>
                )}

                {SUITE_DEBUG_HINTS[f.suite] && (
                  <div class="bg-slate-950 border border-slate-800 rounded-lg p-3.5 mt-4 text-xs">
                    <div class="text-slate-500 font-bold uppercase text-[10px] tracking-wider mb-2">Common failure causes & solutions</div>
                    <ul class="space-y-1 text-slate-400">
                      {SUITE_DEBUG_HINTS[f.suite].map((h: string) => (
                        <li class="flex items-start gap-1.5">
                          <span class="text-amber-500 shrink-0">›</span>
                          <span set:html={h} />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- PR Test Status Matrix -->
    {prList.length > 0 && (
      <div class="mb-10" id="pr-matrix-section">
        <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">PR Test Status Matrix</h2>
        <div class="space-y-2">
          {prList.map(({ ctx, runs: prRuns }: any) => {
            const latest = prRuns[0];
            const allFailed = prRuns.every((r: any) => r.overall === 'fail');
            const anyPassed = prRuns.some((r: any) => r.overall === 'passed' || r.overall === 'pass');
            const anyRunning = prRuns.some((r: any) => r.overall === 'running');
            const hasTestData = prRuns.some((r: any) => r.smoke || r.developer || r.system);

            let statusColor = '';
            let statusText = '';
            let borderStyle = '';

            if (anyRunning) {
              const runDur = Math.round((Date.now() - new Date(latest.started_at).getTime()) / 60000);
              statusColor = 'text-blue-400';
              statusText = `${runDur}m running`;
              borderStyle = 'border-l-blue-500';
            } else if (allFailed && !hasTestData) {
              statusColor = 'text-rose-400';
              statusText = 'pipeline failed (no tests)';
              borderStyle = 'border-l-rose-500';
            } else if (allFailed && hasTestData) {
              statusColor = 'text-rose-400';
              statusText = 'tests failing';
              borderStyle = 'border-l-rose-500';
            } else if (anyPassed) {
              statusColor = 'text-emerald-400';
              statusText = 'passed';
              borderStyle = 'border-l-emerald-500';
            } else {
              statusColor = 'text-slate-400';
              statusText = 'mixed';
              borderStyle = 'border-l-slate-700';
            }

            return (
              <div class={`bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4 border-l-4 ${borderStyle}`}>
                <div class="flex items-center gap-4 flex-wrap min-w-0">
                  <a href={ctx.url} target="_blank" rel="noopener" class="text-sm font-bold text-slate-200 hover:text-blue-400">
                    {ctx.repo.split('/')[1]}#{ctx.num}
                  </a>
                  <a href={`${ARGO_UI}/workflows/argo/${latest.id}`} target="_blank" rel="noopener" class="text-xs text-slate-500 font-mono hover:text-blue-400 truncate max-w-[200px]">
                    {latest.id}
                  </a>
                  <span class="text-xs text-slate-400">{latest.label || latest.variant}</span>
                </div>

                <div class="flex items-center gap-4 text-xs ml-auto flex-wrap shrink-0">
                  <span class={`font-bold ${statusColor}`}>{statusText}</span>
                  <div class="flex gap-2">
                    {['smoke', 'developer', 'system'].map((s: string) => {
                      const d = latest[s];
                      if (!d) return null;
                      const isPassed = d.status === 'passed';
                      const score = (d.scenarios || 0) - (d.failed || 0);
                      return (
                        <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${isPassed ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400'}`}>
                          {s}: {score}/{d.scenarios || 0}
                        </span>
                      );
                    })}
                  </div>
                  <span class="text-slate-500 text-[10px]">
                    {prRuns.length} attempt{prRuns.length > 1 ? 's' : ''} • {fmtAgo(latest.started_at)}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Image Status Section -->
    <div class="mb-10">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4 border-b border-slate-800 pb-2">
        <h2 class="text-lg font-bold text-white">Tested Image Status</h2>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="filter-failing" class="rounded border-slate-700 bg-slate-900 text-blue-600 focus:ring-blue-500" />
          <label for="filter-failing" class="text-xs text-slate-400 cursor-pointer select-none font-medium">
            Show failing / untested images only
          </label>
        </div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-glow-blue/5">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-xs text-slate-300">
            <thead class="bg-slate-950 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-4">Image</th>
                <th class="p-4">Smoke</th>
                <th class="p-4">Developer</th>
                <th class="p-4">Software</th>
                <th class="p-4">System ⚑</th>
                <th class="p-4">Flatcar</th>
                <th class="p-4">Last Green</th>
                <th class="p-4">Last Run</th>
                <th class="p-4">Trigger / PR</th>
                <th class="p-4">Workflow</th>
              </tr>
            </thead>
            <tbody id="status-tbody" class="divide-y divide-slate-800/50">
              {IMAGES.map(img => {
                const row = byImage[img.slug] || {};
                const imgSuites = img.suites || SUITES;
                const ALL_COLS = ['smoke', 'developer', 'software', 'system', 'flatcar'];
                
                const lastRuns = ALL_COLS.map(s => row[s]?.last_run).filter(Boolean).sort();
                const lastRun = lastRuns[lastRuns.length - 1];
                const wfNames = ALL_COLS.map(s => row[s]?.workflow_name).filter(Boolean);
                const wf = wfNames[0];
                const pr = wf ? prLabel(wf) : null;
                
                const green = lastGreenRun(row, imgSuites);
                const neverRun = imgSuites.every((s: string) => !row[s] || row[s].status === 'pending' || !row[s].last_run);
                const hasFailure = imgSuites.some((s: string) => row[s]?.status === 'failed');
                const overdueH = nightlyOverdue(img, row);

                const rowStatus = hasFailure ? 'fail' : neverRun ? 'untested' : 'ok';
                const tmpl = WORKFLOW_TEMPLATES[img.slug];

                return (
                  <tr data-status={rowStatus} class={`hover:bg-slate-800/40 transition-colors ${neverRun ? 'opacity-65' : ''}`}>
                    <td class="p-4 font-bold text-slate-200 whitespace-nowrap">
                      {img.label}
                      {neverRun && (
                        <span class="ml-2 px-1.5 py-0.5 bg-slate-800 text-slate-400 border border-slate-700 rounded text-[9px] font-bold tracking-wider uppercase">no data</span>
                      )}
                      {overdueH !== null && (
                        <span class="ml-2 px-1.5 py-0.5 bg-rose-500/10 text-rose-400 border border-rose-500/20 rounded text-[9px] font-bold tracking-wider uppercase" title="Overdue nightly pipeline run">overdue {overdueH}h</span>
                      )}
                      {(hasFailure || neverRun) && tmpl && (
                        <a href={`${ARGO_UI}/workflow-templates/argo/${tmpl}`} target="_blank" rel="noopener" class="ml-2 text-[10px] text-blue-400 hover:underline hover:text-blue-300">▶ run</a>
                      )}
                    </td>

                    {ALL_COLS.map(s => {
                      if (!imgSuites.includes(s)) {
                        return <td class="p-4 text-slate-600">—</td>;
                      }
                      const cell = row[s];
                      if (!cell) {
                        return <td class="p-4 text-slate-500">pending</td>;
                      }
                      const score = cell.scenarios - cell.failed;
                      const status = cell.status;

                      return (
                        <td class="p-4 whitespace-nowrap">
                          {status === 'running' ? (
                            <a href={`${ARGO_UI}/workflows/argo/${cell.workflow_name}`} target="_blank" class="text-blue-400 hover:underline">running</a>
                          ) : status === 'passed' ? (
                            <a href={`${ARGO_UI}/workflows/argo/${cell.workflow_name}`} target="_blank" class="text-emerald-400 hover:underline">✓ {score}/{cell.scenarios}</a>
                          ) : status === 'failed' ? (
                            <a href={`${ARGO_UI}/workflows/argo/${cell.workflow_name}`} target="_blank" class="text-rose-400 hover:underline font-bold">✗ {score}/{cell.scenarios}</a>
                          ) : (
                            <span class="text-slate-500">pending</span>
                          )}
                        </td>
                      );
                    })}

                    <td class="p-4 text-slate-400 font-semibold whitespace-nowrap">
                      {green ? fmtAgo(green) : <span class="text-slate-600">—</span>}
                    </td>
                    <td class="p-4 text-slate-500 whitespace-nowrap">
                      {lastRun ? fmtAgo(lastRun) : 'never'}
                    </td>
                    <td class="p-4 whitespace-nowrap">
                      {pr ? (
                        <a href={pr.url} target="_blank" class="text-blue-400 hover:underline">{pr.repo}#{pr.num}</a>
                      ) : lastRun ? (
                        <span class="text-slate-500">nightly</span>
                      ) : (
                        <span class="text-slate-600">—</span>
                      )}
                    </td>
                    <td class="p-4 font-mono whitespace-nowrap text-slate-500">
                      {wf ? (
                        <a href={`${ARGO_UI}/workflows/argo/${wf}`} target="_blank" class="hover:text-blue-400">
                          {wf.length > 20 ? wf.substring(0, 18) + '…' : wf}
                        </a>
                      ) : '—'}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Running Queue Section -->
    {activeRunning.length > 0 && (
      <div class="mb-10" id="queue-section">
        <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Currently Running Pipelines ({activeRunning.length})</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {activeRunning.map(r => {
            const dur = Math.round((Date.now() - new Date(r.started_at).getTime()) / 60000);
            const pr = prLabel(r.id);
            return (
              <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex gap-3 items-center border-l-4 border-l-blue-500">
                <span class="w-2.5 h-2.5 bg-blue-500 rounded-full animate-ping shrink-0"></span>
                <div class="min-w-0">
                  <a href={`${ARGO_UI}/workflows/argo/${r.id}`} target="_blank" rel="noopener" class="text-sm font-bold text-slate-200 font-mono hover:text-blue-400 block truncate">
                    {r.id}
                  </a>
                  <div class="text-xs text-slate-400 mt-1 flex flex-wrap gap-x-2">
                    <span>{r.label || r.variant}</span>
                    <span class="text-blue-400 font-semibold">{dur}m running</span>
                    {pr && (
                      <span class="text-slate-500">PR: #{pr.num}</span>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Cluster Health Strip -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Lab Cluster Health</h2>
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-glow-cyan/5 text-xs text-slate-300 flex flex-wrap gap-x-6 gap-y-4 items-center justify-between">
        <div class="flex items-center gap-4 flex-wrap">
          {stats.factory?.cluster?.nodes?.map((n: any) => (
            <span class="inline-flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${n.status === 'ready' ? 'bg-emerald-400' : 'bg-rose-400'}`}></span>
              <strong class="text-slate-100">{n.name}</strong>
              <span class="text-slate-500">{n.role} • {n.ram_gb}GB • {n.cpu_threads}t</span>
            </span>
          ))}
        </div>
        
        <div class="flex items-center gap-6 flex-wrap">
          <span class="flex items-center gap-2">
            <span>ContainerDisk:</span>
            <div class="inline-flex gap-0.5">
              {Array.from({ length: stats.factory?.semaphores?.containerdisk?.capacity || 8 }, (_, i) => (
                <span class={`w-2.5 h-3 rounded-sm border ${i < (stats.factory?.semaphores?.containerdisk?.active || 0) ? 'bg-blue-500 border-blue-500' : 'bg-slate-800 border-slate-700'}`}></span>
              ))}
            </div>
            <span class="text-slate-400 font-semibold">{stats.factory?.semaphores?.containerdisk?.active || 0}/{stats.factory?.semaphores?.containerdisk?.capacity || 8}</span>
          </span>

          <span class="flex items-center gap-2">
            <span>HostDisk:</span>
            <div class="inline-flex gap-0.5">
              {Array.from({ length: stats.factory?.semaphores?.hostdisk?.capacity || 3 }, (_, i) => (
                <span class={`w-2.5 h-3 rounded-sm border ${i < (stats.factory?.semaphores?.hostdisk?.active || 0) ? 'bg-blue-500 border-blue-500' : 'bg-slate-800 border-slate-700'}`}></span>
              ))}
            </div>
            <span class="text-slate-400 font-semibold">{stats.factory?.semaphores?.hostdisk?.active || 0}/{stats.factory?.semaphores?.hostdisk?.capacity || 3}</span>
          </span>

          <span class="text-slate-500 font-medium">k3s • {stats.factory?.cluster?.total_ram_gb || 128}GB total</span>
        </div>
      </div>
    </div>

    <!-- Recent Runs Section -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Recent Execution Runs</h2>
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-xs text-slate-300">
            <thead class="bg-slate-950 text-[10px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-4">Workflow</th>
                <th class="p-4">Image</th>
                <th class="p-4">Smoke</th>
                <th class="p-4">Developer</th>
                <th class="p-4">Software</th>
                <th class="p-4">System ⚑</th>
                <th class="p-4">Duration</th>
                <th class="p-4">Trigger</th>
                <th class="p-4">Result</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50">
              {runs.map((r: any) => {
                const dur = r.overall === 'running'
                  ? 'running…'
                  : (r.duration_min ? r.duration_min + 'm' : '—');
                const badgeStyle = r.overall === 'passed' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                  : r.overall === 'fail' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20'
                  : 'bg-blue-500/10 text-blue-400 border border-blue-500/20';

                const pr = prLabel(r.id);
                const ss = r.suite_scores || {};
                const suiteData = (name: string) => ss[name] || r[name] || null;

                return (
                  <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="p-4 font-mono font-bold whitespace-nowrap text-slate-300">
                      <a href={`${ARGO_UI}/workflows/argo/${r.id}`} target="_blank" class="hover:text-blue-400">
                        {r.id.length > 25 ? r.id.substring(0, 23) + '…' : r.id}
                      </a>
                    </td>
                    <td class="p-4 text-slate-400 whitespace-nowrap">{r.label || r.variant}</td>

                    {['smoke', 'developer', 'software', 'system'].map(s => {
                      const d = suiteData(s);
                      if (!d) return <td class="p-4 text-slate-600">—</td>;
                      const isPassed = d.status === 'passed';
                      const score = (d.scenarios || 0) - (d.failed || 0);
                      return (
                        <td class={`p-4 whitespace-nowrap font-semibold ${isPassed ? 'text-emerald-400' : 'text-rose-400'}`}>
                          <a href={`${ARGO_UI}/workflows/argo/${r.id}`} target="_blank" class="hover:underline">
                            {score}/{d.scenarios || 0}
                          </a>
                        </td>
                      );
                    })}

                    <td class="p-4 text-slate-500">{dur}</td>
                    <td class="p-4 whitespace-nowrap text-slate-400">
                      {pr ? (
                        <a href={pr.url} target="_blank" class="text-blue-400 hover:underline">{pr.repo}#{pr.num}</a>
                      ) : (
                        triggerLabel(r)
                      )}
                    </td>
                    <td class="p-4">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${badgeStyle}`}>{r.overall}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Screenshots Section -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Latest Verification Screenshots</h2>
      <div class="flex flex-wrap gap-6">
        {IMAGES.map(img => {
          const url = `https://projectbluefin.github.io/testing-lab/screenshots/${img.slug}-smoke-latest.png`;
          return (
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 shadow-glow-cyan/5 w-[140px] shrink-0 text-center">
              <img src={url} alt={`${img.label}`} class="w-[120px] h-[68px] object-cover rounded-lg border border-slate-800 hover:border-blue-400 cursor-pointer transition-all duration-200" onclick="window.open(this.src,'_blank')" />
              <div class="text-[10px] font-bold text-slate-400 mt-2 truncate">{img.label}</div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- History Tables Grid -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-2">Historical Suite Runs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {IMAGES.map(img => {
          const imgSuites = img.suites || SUITES;
          const rows: any[] = [];
          for (const s of imgSuites) {
            const d = byImage[img.slug]?.[s];
            if (!d?.history?.length) continue;
            for (const h of d.history) {
              rows.push({ suite: s, wf: d.workflow_name, ...h });
            }
          }
          rows.sort((a, b) => (b.run || b.run_date || '').localeCompare(a.run || a.run_date || ''));
          const topRows = rows.slice(0, 10);

          return (
            <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
              <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 font-bold text-slate-200 text-xs tracking-wide">
                {img.label}
              </div>
              <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-[10px] text-slate-400">
                  <thead class="bg-slate-950 font-bold text-slate-500 uppercase tracking-wider border-b border-slate-800">
                    <tr>
                      <th class="p-3">Date</th>
                      <th class="p-3">Suite</th>
                      <th class="p-3">Status</th>
                      <th class="p-3">Score</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-800/50">
                    {topRows.length > 0 ? (
                      topRows.map(r => {
                        const passed = (r.scenarios || 0) - (r.failed || 0);
                        const isPassed = r.status === 'passed';
                        return (
                          <tr class="hover:bg-slate-800/20">
                            <td class="p-3 whitespace-nowrap">{fmt(r.run || r.run_date)}</td>
                            <td class="p-3 text-slate-300 font-semibold">{r.suite}</td>
                            <td class={`p-3 font-bold ${isPassed ? 'text-emerald-400' : 'text-rose-400'}`}>{r.status}</td>
                            <td class="p-3 font-mono">{r.scenarios > 0 ? `${passed}/${r.scenarios}` : '—'}</td>
                          </tr>
                        );
                      })
                    ) : (
                      <tr>
                        <td colspan="4" class="p-4 text-center text-slate-600">No historical runs yet</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // Filter status table client-side function
  function filterStatusTable(failingOnly) {
    document.querySelectorAll('#status-tbody tr[data-status]').forEach(tr => {
      const s = tr.dataset.status;
      tr.style.display = (failingOnly && s === 'ok') ? 'none' : '';
    });
  }

  // Bind change handler
  const filterCheckbox = document.getElementById('filter-failing');
  if (filterCheckbox) {
    filterCheckbox.addEventListener('change', (e) => {
      filterStatusTable(e.target.checked);
    });
  }

  // Auto-refresh every 5 minutes
  setTimeout(() => location.reload(), 5 * 60 * 1000);
</script>
