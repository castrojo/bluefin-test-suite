    'Wayland display: ensure DISPLAY/WAYLAND_DISPLAY set in session',
  ],
  developer: [
    '#237 — uinput device may be unavailable; check /dev/uinput permissions',
    'Ptyxis new-tab: verify uinput setup step ran without error in Argo logs',
    'Podman: check podman info returns successfully in the VM',
  ],
  software: [
    'Bazaar: verify GNOME Software launched and flatpak remote is enabled',
    'Flatpak: check flatpak list --app returns expected apps',
  ],
  system: [
    '⚑ PLATFORM CONTRACT — these failures block image promotion',
    'composefs: check mount | grep composefs in VM',
    'fs-verity: check fsverity measure /usr/bin/bash',
    'bootc: check bootc status shows correct deployment',
    'uupd: check systemctl status uupd and journal for staged deployment errors',
  ],
  flatcar: [
    'Check systemd units are active: systemctl status',
    'Container runtime: check docker info or containerd status',
