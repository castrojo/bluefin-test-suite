---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import summaryData from '../data/compiled/summary-index.json';

const { aggregates, runs } = summaryData;
const lastUpdated = new Date(summaryData.last_updated).toLocaleString();

const passRatePercent = (aggregates.overall_pass_rate * 100).toFixed(1);
const averageDurationMin = (aggregates.average_test_duration_ms / 1000 / 60).toFixed(1);

const ARGO_UI = 'http://192.168.1.102:32746';
const GH_REPO = 'https://github.com/projectbluefin/lab';
---

<Layout title="Project Bluefin QA Dashboard">
  <Header />

  <main class="container mx-auto px-4 py-8 max-w-7xl flex-grow">
    <!-- Header Summary Strip -->
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-8 gap-4 border-b border-slate-800/60 pb-6">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white mb-1">QA Observability Dashboard</h1>
        <div class="text-xs text-slate-400 flex flex-wrap items-center gap-2">
          <span>Last compiled: {lastUpdated}</span>
          <span>•</span>
          <a href={ARGO_UI} target="_blank" rel="noopener" class="text-blue-400 hover:underline">Argo UI</a>
          <span>•</span>
          <a href={GH_REPO} target="_blank" rel="noopener" class="text-blue-400 hover:underline">lab</a>
        </div>
      </div>
      
      <!-- Global Search Bar Integration -->
      <div class="w-full md:w-auto md:min-w-[400px]">
        <GlobalSearch />
      </div>
    </div>

    <!-- Quick Links Bar -->
    <div class="flex flex-wrap gap-2.5 items-center mb-8 text-xs">
      <span class="text-slate-400 font-semibold">Quick links:</span>
      <a href={`${ARGO_UI}/workflows/argo?phase=Failed`} target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">⚠ Failed workflows</a>
      <a href={`${ARGO_UI}/workflows/argo?phase=Running`} target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">▶ Running workflows</a>
      <a href="https://github.com/projectbluefin/lab/issues?q=is%3Aopen+label%3Abug" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">Bugs</a>
      <a href="https://github.com/projectbluefin/lab/issues/new/choose" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">+ File issue</a>
      <a href="https://github.com/projectbluefin/lab/blob/main/RUNBOOK.md" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">RUNBOOK</a>
      <a href="https://github.com/projectbluefin/lab/blob/main/docs/agent-cheatsheet.md" target="_blank" rel="noopener" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-1.5 rounded-lg transition-all duration-200">Cheatsheet</a>
    </div>

    <!-- Aggregates Stats Grid -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-12">
      <!-- Card: Overall Pass Rate -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-md shadow-glow-blue/5">
        <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Pass Rate</p>
        <div class="flex items-baseline gap-2">
          <span class="text-4xl font-extrabold text-emerald-400 font-mono">{passRatePercent}%</span>
          <span class="text-sm text-slate-500">overall</span>
        </div>
        <div class="w-full bg-slate-800 h-1.5 rounded-full mt-4 overflow-hidden">
          <div class="bg-emerald-500 h-full rounded-full" style={`width: ${passRatePercent}%`}></div>
        </div>
      </div>

      <!-- Card: Total Executions -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-md shadow-glow-blue/5">
        <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Executions</p>
        <div class="flex items-baseline gap-2">
          <span class="text-4xl font-extrabold text-blue-500 font-mono">{aggregates.total_runs}</span>
          <span class="text-sm text-slate-500">runs tracked</span>
        </div>
        <p class="text-xs text-slate-500 mt-5">Including bluefin, -lts, aurora, and dakota</p>
      </div>

      <!-- Card: Avg Execution Time -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-md shadow-glow-blue/5">
        <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Avg Run Duration</p>
        <div class="flex items-baseline gap-2">
          <span class="text-4xl font-extrabold text-indigo-400 font-mono">{averageDurationMin}m</span>
          <span class="text-sm text-slate-500">per suite</span>
        </div>
        <p class="text-xs text-slate-500 mt-5">Decoupled VM boot & validation cycle</p>
      </div>
    </div>

    <!-- Active Streams / Variant Cards -->
    <h2 class="text-2xl font-bold tracking-tight text-white mb-6">OCI Image Streams</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-12">
      {Object.entries(aggregates.flavors).map(([flavorName, stats]: [string, any]) => {
        const rate = stats.runs > 0 ? (stats.passed / stats.runs * 100).toFixed(0) : "100";
        return (
          <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 flex flex-col justify-between hover:border-brand-glow/45 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-bold text-white capitalize">{flavorName}</h3>
                <span class={`px-2 py-0.5 rounded text-xs font-mono font-semibold border ${
                  stats.failed > 0 
                    ? "bg-rose-500/10 text-rose-400 border-rose-500/20" 
                    : "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
                }`}>
                  {rate}% Pass
                </span>
              </div>
              <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono text-slate-400 bg-slate-950 p-3 rounded-lg border border-slate-800/60 mb-4">
                <div>
                  <p class="text-slate-500">Runs</p>
                  <p class="font-bold text-white mt-0.5">{stats.runs}</p>
                </div>
                <div>
                  <p class="text-emerald-500">Passed</p>
                  <p class="font-bold text-emerald-400 mt-0.5">{stats.passed}</p>
                </div>
                <div>
                  <p class="text-rose-500">Failed</p>
                  <p class="font-bold text-rose-400 mt-0.5">{stats.failed}</p>
                </div>
              </div>
            </div>
            <a href={`#`} class="text-xs font-semibold text-slate-400 hover:text-blue-400 transition-colors flex items-center gap-1">
              View target filters
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        )
      })}
    </div>

    <!-- Executions Listing Section -->
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-white">Recent Verification Runs</h2>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-md">
      {runs.length === 0 ? (
        <div class="p-12 text-center text-slate-500">
          <svg class="w-12 h-12 text-slate-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <p class="text-base font-semibold text-slate-400">No test runs detected</p>
        </div>
      ) : (
        <div class="divide-y divide-slate-800">
          {runs.map((run: any) => (
            <div class="p-6 hover:bg-slate-950/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-start gap-4">
                <div class={`w-10 h-10 rounded-lg flex items-center justify-center border shrink-0 ${
                  run.status === 'success' || run.status === 'passed'
                    ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" 
                    : "bg-rose-500/10 border-rose-500/20 text-rose-400"
                }`}>
                  {run.status === 'success' || run.status === 'passed' ? (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  ) : (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  )}
                </div>
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <a href={`${import.meta.env.BASE_URL}run/${run.id}`} class="text-base font-bold text-white hover:text-blue-400 transition-colors font-mono">
                      {run.id}
                    </a>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-slate-800 border border-slate-700 text-slate-300">
                      {run.flavor}
                    </span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-blue-500/10 border border-blue-500/25 text-blue-400">
                      {run.stream}
                    </span>
                  </div>
                  <div class="text-xs text-slate-500 font-mono flex flex-wrap gap-x-4 gap-y-1">
                    <span>Version: {run.version}</span>
                    <span>Commit: <a href={`https://github.com/projectbluefin/common/commit/${run.commit_sha}`} target="_blank" class="text-blue-400 hover:underline">{run.commit_sha.substring(0, 7)}</a></span>
                    <span>Duration: {(run.duration_ms / 1000).toFixed(0)}s</span>
                  </div>
                </div>
              </div>
              
              <div class="flex items-center justify-between sm:justify-end gap-6 shrink-0 border-t border-slate-800/40 pt-4 sm:pt-0 sm:border-0">
                <div class="text-left sm:text-right font-mono text-xs">
                  <p class="text-slate-400">Tests Count</p>
                  <p class="text-sm font-semibold mt-0.5">
                    <span class="text-emerald-400">{run.metrics.passed}</span> / <span class="text-rose-400">{run.metrics.failed}</span> / <span class="text-slate-500">{run.metrics.total}</span>
                  </p>
                </div>
                <div class="text-right font-mono text-xs">
                  <p class="text-slate-500">Timestamp</p>
                  <p class="text-slate-400 mt-0.5">{new Date(run.timestamp).toLocaleTimeString()}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
