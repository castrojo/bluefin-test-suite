---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import LogViewer from '../../components/LogViewer.astro';
import { parseAnsiToHtml } from '../../utils/ansi.js';

export async function getStaticPaths() {
  const runFiles = import.meta.glob('../../data/runs/*.json', { eager: true });
  
  return Object.entries(runFiles).map(([filePath, fileContent]) => {
    const id = filePath.split('/').pop().replace('.json', '');
    const runData = (fileContent as any).default || fileContent;
    
    return {
      params: { id },
      props: { run: runData },
    };
  });
}

const { run } = Astro.props;

// Process ANSI escape codes in logs for each step at build time
const processedSteps = run.tests.map((test: any) => ({
  name: test.name,
  status: test.status,
  duration_ms: test.duration_ms,
  htmlLogs: parseAnsiToHtml(test.logs || ''),
  logs: test.logs || ''
}));

const formattedDate = new Date(run.timestamp).toLocaleString();
---

<Layout title={`Run Details: ${run.id}`}>
  <Header />

  <main class="container mx-auto px-4 py-8 max-w-7xl flex-grow" data-pagefind-body>
    <!-- Back Navigation -->
    <div class="mb-6 search-ignore">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to verification runs
      </a>
    </div>

    <!-- Header / Title -->
    <div class="border-b border-slate-800 pb-6 mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-3 mb-2">
          <h1 class="text-3xl font-extrabold tracking-tight text-white font-mono" data-pagefind-meta="title">
            {run.id}
          </h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase bg-blue-500/10 border border-blue-500/20 text-blue-400">
            {run.stream}
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase bg-slate-800 border border-slate-700 text-slate-300">
            {run.flavor}
          </span>
        </div>
        <p class="text-sm text-slate-400">Continuous integration verification run</p>
      </div>
      
      <div>
        <!-- Status Badges -->
        <div class="flex items-center gap-2">
          <!-- Pagefind Meta Exposing -->
          <meta data-pagefind-meta="status" content={run.summary.status} />
          <meta data-pagefind-meta="environment" content={run.environment.runner_id} />
          <meta data-pagefind-meta="commit" content={run.git_commit.sha.substring(0, 7)} />
          <span class="hidden" data-pagefind-meta="date" data-pagefind-sort="date">{run.timestamp}</span>

          <span class={`inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border ${
            run.summary.status === 'success' || run.summary.status === 'passed'
              ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
              : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
          }`}>
            {run.summary.status.toUpperCase()}
          </span>
        </div>
      </div>
    </div>

    <!-- Hero Run Info Bar -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <div>
        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Timestamp</p>
        <p class="text-base font-bold text-white font-mono">{formattedDate}</p>
      </div>
      <div>
        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Environment Node</p>
        <p class="text-base font-bold text-white font-mono">{run.environment.runner_id}</p>
      </div>
      <div>
        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Git Commit SHA</p>
        <a href={`${run.git_commit.repo_url}/commit/${run.git_commit.sha}`} 
           target="_blank" 
           class="text-base font-bold text-blue-400 hover:underline font-mono truncate block">
          {run.git_commit.sha.substring(0, 7)}
        </a>
      </div>
      <div>
        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Testing Lab Kernel</p>
        <p class="text-base font-bold text-white font-mono">K3s: {run.environment.k3s_version}</p>
      </div>
    </div>

    <!-- Failures Banner -->
    {run.summary.failed_tests > 0 && (
      <div class="bg-rose-500/10 border border-rose-500/25 rounded-xl p-6 mb-8 flex gap-4 items-start search-ignore">
        <div class="w-8 h-8 rounded-lg bg-rose-500/20 border border-rose-500/30 flex items-center justify-center shrink-0 text-rose-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-rose-400 mb-1">Suite execution has failed assertions</h2>
          <p class="text-sm text-slate-400">
            {run.summary.failed_tests} out of {run.summary.total_tests} test assertions failed. Scroll down to expand failures and inspect step execution outputs.
          </p>
        </div>
      </div>
    )}

    <!-- Interactive Log Viewer -->
    <h2 class="text-2xl font-bold text-white mb-4">Verification Logs</h2>
    <LogViewer steps={processedSteps} />
  </main>
</Layout>